# SeaweedFS S3 gateway: containers reach it by Docker service name, not localhost.
S3_ENDPOINT=http://seaweedfs:8333

FSSPEC_S3_ENDPOINT_URL=$S3_ENDPOINT_URL

# OFFLINE_STORAGE=bigquery only: the project lives at /app inside the container, and there is no gcloud
# login there -> see README Infrastructure > Cloud > BigQuery
FEAST_FS_YAML_FILE_PATH=/app/src/winterload/feature_repo/feature_store.bigquery.yaml
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp-service-account.json
