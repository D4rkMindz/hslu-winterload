# Copy this file to .env

# ENTSO-E configuration

# ENTSO-E Transparency Platform API key: https://transparency.entsoe.eu/ -> My Account Settings -> Web API Security Token
# -> https://transparency.entsoe.eu/myAccount/webApiAccess
ENTSOE_API_KEY=

# Feast configuration
FEAST_PROJECT=winterload

# Root logger level: DEBUG, INFO, WARNING, ERROR, or CRITICAL
LOG_LEVEL=INFO

# GCP project backing the Firestore (Datastore mode) online store
GCP_PROJECT_ID=

# Local path (or s3://bucket/... when using SeaweedFS) for the offline Parquet data,
# relative to src/winterload/feature_repo/ when a plain local path
FEAST_OFFLINE_STORE_PATH=s3://winterload/offline

# S3 storage. Local: SeaweedFS, reachable via its Docker service name on the
# `winterload-development`/`winterload-production` networks (NOT localhost, containers can't reach each other via localhost).
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY_ID=winterload
S3_SECRET_ACCESS_KEY=<your super secret access key here)
S3_DEFAULT_REGION=us-east-1

# python-dotenv only interpolates ${VAR} (braces required) -- bare $VAR is not expanded.
S3_ENDPOINT_URL=${S3_ENDPOINT}
AWS_ACCESS_KEY_ID=${S3_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${S3_SECRET_ACCESS_KEY}
AWS_DEFAULT_REGION=${S3_DEFAULT_REGION}