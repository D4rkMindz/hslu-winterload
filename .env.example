# Copy this file to .env

# Root logger level: DEBUG, INFO, WARNING, ERROR, or CRITICAL
LOG_LEVEL=INFO

# ENTSO-E Transparency Platform API key: https://transparency.entsoe.eu/ -> My Account Settings -> Web API Security Token
# -> https://transparency.entsoe.eu/myAccount/webApiAccess
ENTSOE_API_KEY=

# Feast configuration
FEAST_PROJECT=winterload

# Where the backfill pipelines write the features and Feast reads them from: "s3" (default, the
# SeaweedFS/local Parquet store below) or "bigquery" (see README, "Offline storage")
OFFLINE_STORAGE=s3

# The Feast config matching OFFLINE_STORAGE. Leave it commented out for s3 (Feast then uses
# feature_store.yaml); for bigquery, uncomment it. Must be an absolute path: Feast opens it relative
# to the current working directory, which differs between `make apply` and the notebooks.
#FEAST_FS_YAML_FILE_PATH=/absolute/path/to/project-repo/src/winterload/feature_repo/feature_store.bigquery.yaml

# Local path (or s3://bucket/... when using SeaweedFS) for the offline Parquet data,
# relative to src/winterload/feature_repo/ when a plain local path
FEAST_OFFLINE_STORE_PATH=s3://winterload/offline

# GCP project backing the Firestore (Datastore mode) online store, and the BigQuery offline store
GCP_PROJECT_ID=winterload

# BigQuery dataset holding the feature tables, and its location (europe-west6 = Zurich). Keep both set
# when using bigquery: feature_store.bigquery.yaml reads them from here, not from the code's defaults.
BIGQUERY_DATASET=winterload
BIGQUERY_LOCATION=europe-west6

# S3 storage. Local: SeaweedFS, reachable via its Docker service name on the
# `winterload-development`/`winterload-production` networks (NOT localhost, containers can't reach each other via localhost).
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY_ID=winterload
S3_SECRET_ACCESS_KEY=<your super secret access key here)
S3_DEFAULT_REGION=us-east-1

# python-dotenv only interpolates ${VAR}
AWS_ACCESS_KEY_ID=${S3_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${S3_SECRET_ACCESS_KEY}
AWS_DEFAULT_REGION=${S3_DEFAULT_REGION}

# use alias for s3fs
FSSPEC_S3_ENDPOINT_URL=${S3_ENDPOINT}
FSSPEC_S3_KEY=${S3_ACCESS_KEY_ID}
FSSPEC_S3_SECRET=${S3_SECRET_ACCESS_KEY}