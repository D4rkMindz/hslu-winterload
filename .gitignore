__pycache__

*.env*
!.env.example
!.env.docker.example

*.cache.sqlite
*-pycharm-support-libs

/data/*
!/data/.gitkeep

/src/winterload/feature_repo/data/*

# service account keys etc., mounted into the container (see docker-compose.yaml)
/secrets/

