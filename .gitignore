/infra/.terraform/
*.tfstate
*.tfstate.*
crash.log

.claude

# MLflow keeps runs and models in its Docker volume. Nothing of them belongs in git.
mlruns/
mlartifacts/
/models/
*.pkl
*.joblib
*.skops
